# ==================================================
# DATABASE CONFIGURATION 
# ==================================================

POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=ai_agent_db
# Note: Inside Docker, the host is 'db'. Locally, it might be 'localhost'
DATABASE_URL=postgresql://admin:your_secure_password_here@db:5432/ai_agent_db

# ==================================================
# SECURITY & AUTHENTICATION 
# ==================================================
# Generate a strong random string for this (e.g Python's secrets module)
SECRET_KEY=your_very_long_and_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTE=60

# ==================================================
# AI & LLM CONFIGURATION 
# ==================================================
GOOGLE_API_KEY=your_google_gemini_api_key_here
LLM_MODEL_NAME=gemini-pro
EMBEDDING_MODEL_NAME=gemini_embedding

# ==================================================
# APPLICATION SETTINGS 
# ==================================================
ENVIRONMENT=development
DEBUG=True